import pandas as pd
import matplotlib.pyplot as plt
import glob
import os
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
from sklearn.decomposition import PCA
folder = os.path.dirname(os.path.abspath(__file__))
csv_files = glob.glob(os.path.join(folder, "*.csv"))
if not csv_files:
    print("No CSV file found in the Wine_Case_Study folder.")
    exit()
file_path = csv_files[0]
print("Using dataset:", os.path.basename(file_path))
df = pd.read_csv(file_path)
print("\nDataset:")
print(df.head())
print("\nDataset Shape:", df.shape)
print("\nColumns:")
print(df.columns.tolist())
if 'Sample' in df.columns:
    X = df.drop(columns=['Sample'])
else:
    X = df.copy()
X = X.select_dtypes(include='number')
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
print("\nStandardized Data:")
print(X_scaled[:5])
inertia = []
max_k = min(10, len(X) - 1)
for k in range(2, max_k + 1):
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(X_scaled)
    inertia.append(kmeans.inertia_)
plt.figure(figsize=(8, 5))
plt.plot(range(2, max_k + 1), inertia, marker='o')
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Inertia")
plt.title("Elbow Method")
plt.show()
silhouette_scores = []
for k in range(2, max_k + 1):
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = kmeans.fit_predict(X_scaled)
    score = silhouette_score(X_scaled, labels)
    silhouette_scores.append(score)
    print(f"K = {k}, Silhouette Score = {score:.4f}")
plt.figure(figsize=(8, 5))
plt.plot(range(2, max_k + 1), silhouette_scores, marker='o')
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Silhouette Score")
plt.title("Silhouette Score")
plt.show()
best_k = range(2, max_k + 1)[silhouette_scores.index(max(silhouette_scores))]
best_score = max(silhouette_scores)
print("\nBest K:", best_k)
print("Best Silhouette Score:", best_score)
kmeans = KMeans(n_clusters=best_k, random_state=42, n_init=10)
clusters = kmeans.fit_predict(X_scaled)
df['Cluster'] = clusters
print("\nCluster Counts:")
print(df['Cluster'].value_counts().sort_index())
cluster_profile = df.groupby('Cluster').mean(numeric_only=True)
print("\nCluster Profiles:")
print(cluster_profile.round(2))
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)
pca_df = pd.DataFrame(X_pca, columns=['PC1', 'PC2'])
pca_df['Cluster'] = clusters
print("\nPCA Data:")
print(pca_df.head())
plt.figure(figsize=(8, 6))
for cluster in sorted(pca_df['Cluster'].unique()):
    data = pca_df[pca_df['Cluster'] == cluster]
    plt.scatter(data['PC1'], data['PC2'], label=f'Cluster {cluster}')
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("K-Means Clusters using PCA")
plt.legend()
plt.show()
print("\nPCA Explained Variance:")
print(pca.explained_variance_ratio_)
print("\nTotal Explained Variance:", pca.explained_variance_ratio_.sum())
print("\nWine Case Study Completed Successfully!")
