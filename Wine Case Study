import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA, FastICA
from sklearn.decomposition import FactorAnalysis
from sklearn.mixture import GaussianMixture
data = {
    'Alcohol': [14.23,13.20,13.16,14.37,13.24,14.20,14.39,14.06,14.83,13.86],
    'MalicAcid': [1.71,1.78,2.36,1.95,2.59,1.76,1.87,2.15,1.64,1.35],
    'Ash': [2.43,2.14,2.67,2.50,2.87,2.45,2.45,2.61,2.17,2.27],
    'Alcalinity': [15.6,11.2,18.6,16.8,21.0,15.2,14.6,17.6,14.0,16.0],
    'Magnesium': [127,100,101,113,118,112,96,121,97,98],
    'Phenols': [2.80,2.65,2.80,3.85,2.80,3.27,2.50,2.60,2.80,2.98]
}
df = pd.DataFrame(data)
scaler = StandardScaler()
X = scaler.fit_transform(df)
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)
fa = FactorAnalysis(n_components=2, random_state=42)
X_fa = fa.fit_transform(X)
ica = FastICA(n_components=2, random_state=42)
X_ica = ica.fit_transform(X)
gmm = GaussianMixture(n_components=2, random_state=42)
cluster_pca = gmm.fit_predict(X_pca)
cluster_fa = gmm.fit_predict(X_fa)
cluster_ica = gmm.fit_predict(X_ica)
print("PCA Result:")
print(X_pca)
print("\nFactor Analysis Result:")
print(X_fa)
print("\nICA Result:")
print(X_ica)
print("\nPCA Clusters:")
print(cluster_pca)
print("\nFactor Analysis Clusters:")
print(cluster_fa)
print("\nICA Clusters:")
print(cluster_ica)
print("\nPCA Explained Variance Ratio:")
print(pca.explained_variance_ratio_)
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=cluster_pca)
plt.xlabel("PCA 1")
plt.ylabel("PCA 2")
plt.title("GMM Clustering after PCA")
plt.show()
plt.scatter(X_fa[:, 0], X_fa[:, 1], c=cluster_fa)
plt.xlabel("Factor 1")
plt.ylabel("Factor 2")
plt.title("GMM Clustering after Factor Analysis")
plt.show()

plt.scatter(X_ica[:, 0], X_ica[:, 1], c=cluster_ica)
plt.xlabel("ICA 1")
plt.ylabel("ICA 2")
plt.title("GMM Clustering after ICA")
plt.show()
